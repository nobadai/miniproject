# 애플리케이션
APP_NAME=finance-ai
APP_ENV=local
APP_DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finance_ai
POSTGRES_USER=finance_ai
POSTGRES_PASSWORD=

# 외부 API
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# STT (보이스피싱 오디오 전사)
STT_MODEL_SIZE=large-v3-turbo
STT_DEVICE=auto
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ko
STT_TELEPHONY_BAND=true
# 전사 캐시 위치. 비워두면 backend/cache/transcripts 를 사용한다.
# STT_CACHE_DIRECTORY=

# 업로드 원본 보관
# 업로드 파일 저장 위치. 비워두면 backend/uploads 를 사용한다.
# UPLOAD_DIRECTORY=
